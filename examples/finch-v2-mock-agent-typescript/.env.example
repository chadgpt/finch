# === Finch AgentOn credentials (Base64URL encoding of raw 32-byte HMAC keys) ===
# Get these from your Provider workspace in finchtech.ai.
# These are EXAMPLES — never commit real values. Rotate via the workspace.

MOCK_REQUEST_SECRET=REPLACE_WITH_BASE64URL_OF_32_REQUEST_SECRET_BYTES
MOCK_CALLBACK_SECRET=REPLACE_WITH_BASE64URL_OF_32_CALLBACK_SECRET_BYTES
MOCK_KEY_ID=finch.agenton.<uuid-from-finch-workspace>

MOCK_PORT=28891
MOCK_AGENT_NAME=finch-async-mock-ts

# === LLM backend (OpenAI-compatible) ===
# P1 conversation_turn calls this LLM and uses its response as the agent's answer.
# Verified 2026-10-13: POST to ${LLM_BASE_URL}/v1/chat/completions with
#   { model, messages: [...], max_tokens } and Bearer auth.
# Working model id: "MiniMax-M3" (or "minimax-china/MiniMax-M3" depending on registration).
# Default baseUrl points at the agw.k0s.io gateway described in the README.
LLM_BASE_URL=https://agw.k0s.io
LLM_API_KEY=-
LLM_MODEL=MiniMax-M3
LLM_SYSTEM_PROMPT=You are a helpful agent. Be concise.
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_MS=30000

# Set to "1" to log signature-mismatch diagnostics on the server.
# DEBUG_SIGN=0
